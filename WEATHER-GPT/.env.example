# ===============================================================
# WeatherGPT Environment Configuration Template
# ===============================================================

# Server Environment
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ---------------------------------------------------------------
# 1. AI Meteorologist Engine (Google Gemini 2.5 Flash)
# Get a free API key at: https://aistudio.google.com/
# ---------------------------------------------------------------
AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------
# 2. Redis Distributed Cache (Optional / Recommended)
# Supports local Redis or cloud Redis (e.g. Upstash, Redis Cloud)
# Format: redis://[[username:]password@]host[:port][/database]
# If left blank, the platform automatically uses embedded SQLite caching.
# ---------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------
# 3. MongoDB Atlas Cluster (Optional)
# For distributed multi-node persistence and GeoJSON 2dsphere indexing.
# If omitted, embedded SQLite database is used automatically.
# ---------------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=weatherspt

# ---------------------------------------------------------------
# 4. Embedded SQLite Database
# ---------------------------------------------------------------
DATABASE_PATH=./data/weathergpt.sqlite

# ---------------------------------------------------------------
# 5. Security & Rate Limiting
# ---------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
CORS_ORIGIN=*
